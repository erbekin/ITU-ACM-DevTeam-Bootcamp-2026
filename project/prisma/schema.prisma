  // Bu dosyanın generator ve datasource blokları hazır geliyor.
  // Modelleri siz yazacaksınız — ODEV-3.md'deki veri modeli bölümüne bakın.

  generator client {
    // DİKKAT: "prisma-client" (tire yok) generator'ı YALNIZCA TypeScript üretir.
    // Düz JavaScript projesinde import anında patlar. Bu satırı değiştirmeyin.
    provider = "prisma-client-js"
  }

  datasource db {
    provider = "postgresql"
    // Bağlantı adresi burada değil, prisma.config.js dosyasında.
  }

  // TODO: model User   — hafta 2'deki alanlar + profile ilişkisi
  // TODO: model Profile — bire-bir (user_id UNIQUE)
  // TODO: model Todo   — hafta 2'deki alanlar + priority + tags ilişkisi
  // TODO: model Tag
  // TODO: model TodoTag — bağlantı tablosu, bileşik birincil anahtar

  model User {
    id        String   @id @default(uuid()) @db.Uuid
    username  String   @unique
    email     String   @unique
    password  String
    createdAt DateTime @default(now()) @map("created_at")

    todos   Todo[]
    profile Profile?

    @@map("users")
  }

  model Todo {
    id          String   @id @default(uuid()) @db.Uuid
    title       String
    description String
    completed   Boolean  @default(false)
    userId      String?  @map("user_id") @db.Uuid
    createdAt   DateTime @default(now()) @map("created_at")

    user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
    todoTags TodoTag[]

    @@index([completed])
    @@map("todos")
  }

  model Profile {
    // Database Fields
    id     Int    @id @default(autoincrement())
    bio    String
    userId String @unique @db.Uuid @map("user_id")

    // user mapping
    user User @relation(fields: [userId], references: [id])
    @@map("profiles")
  }

  model Tag {
    id   Int    @id @default(autoincrement())
    name String @unique

    todoTags TodoTag[]
    @@map("tags")
  }

  model TodoTag {
    todoId String @map("todo_id") @db.Uuid
    tagId  Int    @map("tag_id")

    tag Tag @relation(fields: [tagId], references: [id])
    todo Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)

    @@id([todoId, tagId])
    @@map("todo_tags")
  }
