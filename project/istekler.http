# VS Code "REST Client" eklentisiyle kullanılır.
# Her isteğin üstündeki "Send Request" bağlantısına tıklamanız yeterli.
# Önce: npm run dev

@host = http://localhost:3000

### Sağlık kontrolü — Aşama 0'dan sonra 200 dönmeli
GET {{host}}/

### Tanımsız yol — JSON 404 dönmeli
GET {{host}}/boyle-bir-yol-yok


# ─────────────────────────────  TODOS  ─────────────────────────────

### Tüm todolar
GET {{host}}/todos

### Yeni todo
# @name yeniTodo
POST {{host}}/todos
Content-Type: application/json

{
  "title": "Ödevi bitir",
  "description": "Hafta 2 REST API"
}

### Eksik gövde — 400 beklenir
POST {{host}}/todos
Content-Type: application/json

{
  "description": "başlığı yok"
}

### Tek todo
GET {{host}}/todos/{{yeniTodo.response.body.id}}

### Tam güncelleme (PUT) — üç alan da zorunlu
PUT {{host}}/todos/{{yeniTodo.response.body.id}}
Content-Type: application/json

{
  "title": "Ödevi bitir (güncellendi)",
  "description": "Hafta 2 REST API",
  "completed": true
}

### Kısmi güncelleme (PATCH)
PATCH {{host}}/todos/{{yeniTodo.response.body.id}}
Content-Type: application/json

{
  "completed": true
}

### Boş gövdeyle PATCH — 400 beklenir
PATCH {{host}}/todos/{{yeniTodo.response.body.id}}
Content-Type: application/json

{}

### Silme — 204 ve boş gövde beklenir
DELETE {{host}}/todos/{{yeniTodo.response.body.id}}

### Olmayan id — 404 beklenir
GET {{host}}/todos/00000000-0000-4000-8000-000000000000


# ─────────────────────────────  USERS  ─────────────────────────────

### Yeni kullanıcı — yanıtta password OLMAMALI
# @name yeniUser
POST {{host}}/users
Content-Type: application/json

{
  "username": "farhad",
  "email": "farhad@acm.itu.edu.tr",
  "password": "acmcokyasa123"
}

### Aynı e-posta ikinci kez — 409 beklenir
POST {{host}}/users
Content-Type: application/json

{
  "username": "baskasi",
  "email": "farhad@acm.itu.edu.tr",
  "password": "123456"
}

### Geçersiz e-posta — 400 beklenir
POST {{host}}/users
Content-Type: application/json

{
  "username": "bozukmail",
  "email": "acm-nokta-com",
  "password": "123456"
}

### Tüm kullanıcılar — hiçbirinde password olmamalı
GET {{host}}/users


# ────────────────────────────  İLİŞKİ  ────────────────────────────

### Bir kullanıcıya ait todo oluştur
POST {{host}}/todos
Content-Type: application/json

{
  "title": "Sahipli todo",
  "description": "bir kullanıcıya ait",
  "userId": "{{yeniUser.response.body.id}}"
}

### Olmayan kullanıcıyla todo — 400 beklenir
POST {{host}}/todos
Content-Type: application/json

{
  "title": "Hayalet sahip",
  "description": "böyle bir kullanıcı yok",
  "userId": "00000000-0000-4000-8000-000000000000"
}

### Kullanıcının todoları
GET {{host}}/users/{{yeniUser.response.body.id}}/todos

### Olmayan kullanıcının todoları — 404 beklenir
GET {{host}}/users/00000000-0000-4000-8000-000000000000/todos


# ─────────────────────────────  BONUS  ─────────────────────────────

### Tamamlananlar
GET {{host}}/todos?completed=true

### Arama
GET {{host}}/todos?q=ödev

### İkisi birlikte
GET {{host}}/todos?completed=true&q=ödev


# ═══════════════════════ ÖDEV 3 ═══════════════════════

# ─────────────────────  PRIORITY  ─────────────────────

### Öncelikli todo oluştur
# @name oncelikli
POST {{host}}/todos
Content-Type: application/json

{
  "title": "Acil iş",
  "description": "hemen yapılmalı",
  "priority": 5
}

### Önceliği güncelle
PATCH {{host}}/todos/{{oncelikli.response.body.id}}
Content-Type: application/json

{
  "priority": 1
}


# ──────────────────────  PROFİL  ──────────────────────

### Kullanıcı oluştur
# @name profilliUser
POST {{host}}/users
Content-Type: application/json

{
  "username": "profilli",
  "email": "profilli@acm.itu.edu.tr",
  "password": "gizli123"
}

### Profil oluştur
PUT {{host}}/users/{{profilliUser.response.body.id}}/profile
Content-Type: application/json

{
  "bio": "İTÜ ACM DevTeam üyesi"
}

### Aynı isteği tekrar gönder — yeni profil OLUŞMAMALI, id aynı kalmalı
PUT {{host}}/users/{{profilliUser.response.body.id}}/profile
Content-Type: application/json

{
  "bio": "güncellenmiş biyografi"
}

### Profili oku
GET {{host}}/users/{{profilliUser.response.body.id}}/profile

### Olmayan kullanıcının profili — 404 beklenir
GET {{host}}/users/00000000-0000-4000-8000-000000000000/profile


# ─────────────────────  ETİKETLER  ─────────────────────

### Etiket oluştur
# @name etiket
POST {{host}}/tags
Content-Type: application/json

{
  "name": "acil"
}

### Aynı isimle ikinci kez — 409 beklenir
POST {{host}}/tags
Content-Type: application/json

{
  "name": "acil"
}

### Etiketleri listele
GET {{host}}/tags

### Todo'ya etiket bağla
POST {{host}}/todos/{{oncelikli.response.body.id}}/tags
Content-Type: application/json

{
  "tagId": "{{etiket.response.body.id}}"
}

### Aynı etiketi ikinci kez — 409 beklenir
POST {{host}}/todos/{{oncelikli.response.body.id}}/tags
Content-Type: application/json

{
  "tagId": "{{etiket.response.body.id}}"
}

### Todo'nun etiketleri
GET {{host}}/todos/{{oncelikli.response.body.id}}/tags

### Bağlantıyı kaldır — 204 beklenir (etiketin kendisi silinmez)
DELETE {{host}}/todos/{{oncelikli.response.body.id}}/tags/{{etiket.response.body.id}}

### Etiket hâlâ duruyor mu?
GET {{host}}/tags
